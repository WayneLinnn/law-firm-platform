# ============================================================
# 复制为 backend/.env 后填写。所有配置统一前缀 LFP_
#     cp .env.example backend/.env
# .env 已在 .gitignore 中，绝不入库
# ============================================================

LFP_ENV=dev
LFP_DEBUG=true

# ---------- 数据库 ----------
LFP_DATABASE_URL=postgresql+psycopg://lfp:lfp@localhost:5432/lfp

# ---------- 模块开关 ----------
# * 表示启用全部已发现模块；也可写逗号分隔白名单
LFP_ENABLED_MODULES=*
# 黑名单优先级更高，用于「拆卸测试」
LFP_DISABLED_MODULES=


# ============================================================
#  模型（Step 2）
# ============================================================
# deepseek = 真调 API   fake = 假实现，不联网不花钱，无 key 也能开发和跑测试
LFP_MODEL_BACKEND=deepseek

# ★★★ 在这里填你的 DeepSeek API Key ★★★
# 申请地址：https://platform.deepseek.com/api_keys
LFP_DEEPSEEK_API_KEY=

LFP_DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型档位（2026-08 官方在售型号）
#   deepseek-v4-flash  1M 上下文，$0.22/$0.66 每百万 token（离峰）—— 默认档
#   deepseek-v4-pro    1M 上下文，$0.66/$1.98 每百万 token（离峰）—— 难任务
# 注意：高峰时段价格翻倍（周一至周五 UTC 01:00-04:00、06:00-10:00）
LFP_DEEPSEEK_MODEL=deepseek-v4-flash
LFP_DEEPSEEK_MODEL_PRO=deepseek-v4-pro

LFP_MODEL_TIMEOUT=120
LFP_MODEL_MAX_RETRIES=2


# ============================================================
#  对象存储（Step 2）
# ============================================================
# minio = 真连   fake = 内存实现
LFP_STORAGE_BACKEND=minio
LFP_MINIO_ENDPOINT=localhost:9000
LFP_MINIO_ACCESS_KEY=lfp
LFP_MINIO_SECRET_KEY=lfp123456
LFP_MINIO_BUCKET=lfp-docs
LFP_MINIO_SECURE=false


# ============================================================
#  法律检索服务（Step 8）
# ============================================================
# 独立进程，不在 Docker 里。起法：
#   cd ../langchain-legal-RAG
#   .venv/Scripts/activate
#   uvicorn src.service:app --port 8100
#
# legal_rag = 真连   fake = 假实现，服务没起也能开发和跑 CI
LFP_RETRIEVAL_BACKEND=legal_rag
LFP_LEGAL_RAG_URL=http://127.0.0.1:8100
LFP_LEGAL_RAG_TIMEOUT=60
# 服务间令牌。本机留空；上云必须设，与检索服务的 RAG_SERVICE_TOKEN 一致
LFP_LEGAL_RAG_TOKEN=
